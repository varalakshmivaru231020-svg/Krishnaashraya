# Apache (XAMPP / cPanel hosting): send every request to index.php
# except files that really exist under assets/ and uploads/.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve the application source, templates, database files or config.
    RewriteRule ^(app|templates|database)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]

    # Serve real static files directly.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(assets|uploads)/ - [L]

    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
